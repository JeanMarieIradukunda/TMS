# Copy this file to .env and fill in real values. Never commit the real .env file.

# Django
SECRET_KEY=
DEBUG=False

# Comma-separated extra hosts/origins (the app already trusts tms-pvc.vercel.app,
# localhost and 127.0.0.1 by default - only add values here for a custom domain).
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Database — set DB_ENGINE=postgres for production, or leave unset/"sqlite" for local dev
DB_ENGINE=postgres
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Groq AI (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
