@'
{
  "builds": [
    {
      "src": "training_management/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "training_management/wsgi.py"
    }
  ]
}
'@ | Set-Content -Encoding utf8 vercel.json
